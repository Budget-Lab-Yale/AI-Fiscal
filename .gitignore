# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
!AI-Fiscal.Rproj

# Python (if used for auxiliary tooling)
__pycache__/
*.py[cod]
.venv/
venv/

# Data — never commit raw microdata or intermediate matched files
data/tax_data
data/matched/*
!data/matched/.gitkeep

# results/aggregates/: track only the canonical *_latest.xlsx bundles
# (mirrored on every run by 08 and 09). Timestamp-vintaged xlsx and
# the CSV/PDF artifacts are local archival and stay out of git to
# prevent indefinite repo bloat.
results/aggregates/*
!results/aggregates/*_latest.xlsx
!results/aggregates/.gitkeep

# results/figures/: publishable PNG/PDF figure suite from 10_figures.R.
# Figures are deliverables — track them.

# Large outputs
output/
*.rds
*.parquet
*.feather
*.csv.gz

# OS / editor
.DS_Store
.vscode/
.idea/

# Claude Code per-user state — skills, settings, and history are all
# per-user / per-machine and should not travel via this repo.
.claude/

# scripts/: local ad-hoc shell wrappers (cluster-specific paths,
# personal scratch dirs). The reference SBATCH driver is `slurm_run.sh`
# at the repo root; `scripts/` is for everything else a user wants
# to keep locally without sending upstream.
scripts/

# Logs
*.log
slurm-*.out
logs/

# Local working notes (release punch list, scratch)
todo.md

# Internal / pre-release working docs — kept locally, not part of the
# public release. Provenance lives in CLAUDE.md's "Repo lineage" section.
docs/CODE_REVIEW_*.md
docs/repo_consolidation.md

# Word copy of the methodology — the canonical source is the tracked
# docs/ai_fiscal_methodology.md; avoid shipping a second copy that drifts.
*.docx

# Perf harness output (regenerable; tracked harness lives in tests/perf/)
tests/perf/last_run.csv
tests/perf/profvis.html
